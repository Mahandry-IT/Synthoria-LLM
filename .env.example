[TEMPLATE]
# Ollama configuration
OLLAMA_BASE_URL=http://ollama:11435
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=3

# FastAPI configuration
REQUEST_MAX_PROMPT_LENGTH=8000
CORS_ALLOWED_ORIGINS=["*"]
# Limite globale par IP des requêtes d'écriture (GET/HEAD/OPTIONS non comptées).
RATE_LIMIT_PER_MINUTE=60

# Chroma configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=synthoria_documents

# PDF processing configuration
PDF_CHUNK_TARGET_TOKENS=400
PDF_CHUNK_OVERLAP_TOKENS=50

# Gemini configuration
GEMINI_API_KEY=
# FLASH et FLASH_LITE doivent rester DISTINCTS : les chaînes de repli (GEMINI_CHAIN_*, voir plus
# bas) s'en dérivent par défaut, et un cascade lite -> flash qui retombe sur le même modèle perd
# tout son intérêt (voir README, « Limite de débit Gemini »).
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
# Volontairement plus haut que le défaut applicatif (30s) : les appels de génération structurée
# (schémas complexes) peuvent dépasser 30s sous charge, mieux vaut attendre que lever une erreur.
GEMINI_TIMEOUT_SECONDS=300
# Désactivé par défaut dans ce template : le grounding consomme un appel Gemini supplémentaire par
# question (voir README) — activer explicitement si la recherche web groundée est nécessaire.
GEMINI_USE_SEARCH_GROUNDING=false
# Marge sous la limite Google (ex. 15 RPM sur gemini-*-flash-lite au palier gratuit) : baisser si
# les conteneurs api ET worker sont utilisés de façon intensive en même temps (voir README).
GEMINI_RPM_LIMIT=14
# Répartit GEMINI_RPM_LIMIT entre les process api/worker (différencié par service dans
# docker-compose.yml) plutôt que de laisser chacun croire disposer de la totalité du quota.
GEMINI_RPM_SHARE=1.0
# Chaînes de repli par méthode (lite d'abord, sauf recherche groundée) : laisser vide ([]) pour
# les dériver automatiquement de GEMINI_MODEL_FLASH/GEMINI_MODEL_FLASH_LITE ci-dessus (voir
# README) ; ne fixer que pour un ordre différent ou une chaîne à plus de 2 modèles.
GEMINI_CHAIN_GENERATION=[]
GEMINI_CHAIN_LIGHT=[]
GEMINI_CHAIN_SEARCH=[]
# Quota JOURNALIER par modèle (clé = nom du modèle), ex. '{"gemini-3.6-flash": 100}'. Un modèle
# absent de ce mapping n'a pas de budget RPD suivi (voir README).
GEMINI_MODEL_RPD_LIMITS={}
# Durée du cache mémoire de l'état de quota (évite une requête DB à chaque appel Gemini).
GEMINI_QUOTA_CACHE_TTL_SECONDS=30.0
# Durée du cache Postgres des réponses Gemini (reformulate_query/describe_images/rank_images) :
# réingérer un contenu déjà vu (ex. même PDF) évite un nouvel appel Gemini pendant cette durée.
GEMINI_RESPONSE_CACHE_TTL_HOURS=24

# YouTube Data API v3 : recherche réelle de vidéos (remplace les IDs inventés par Gemini).
# Sans clé, repli automatique sur la recherche groundée Gemini + vérification oEmbed (voir README).
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=5.0
YOUTUBE_SEARCH_MAX_RESULTS=10
YOUTUBE_RELEVANCE_LANGUAGE=fr
YOUTUBE_REGION_CODE=FR
YOUTUBE_MIN_DURATION_SECONDS=240
YOUTUBE_MAX_DURATION_SECONDS=2400
YOUTUBE_MAX_QUERIES=2
YOUTUBE_CACHE_TTL_HOURS=72
# Cible 5 à 10 vidéos par cours (jamais garanti : dépend de ce que YouTube renvoie réellement).
COURSE_VIDEOS_MIN=5
COURSE_VIDEOS_MAX=10
# V2 (optionnel) : classement / catégorisation pédagogique des candidats par Flash-Lite.
COURSE_VIDEOS_RANKING_ENABLED=true
YOUTUBE_RANKING_MIN_SCORE=40

# Course generation (Mode 2) configuration
COURSE_TOP_K_DEFAULT=6
COURSE_QUESTION_MAX_LENGTH=15000
COURSE_PLAN_BATCH_SIZE=4
COURSE_PLAN_TTL_MINUTES=120
# Mode des requetes sans `depth` : express | standard | approfondi
DEFAULT_COURSE_DEPTH=approfondi
# Limite dediee de POST /courses/{id}/sections/{id}/challenge
CHALLENGE_RATE_LIMIT_PER_MINUTE=10
# Reparations max apres regeneration d'une section par l'utilisateur (1 appel Gemini chacune)
SECTION_REGENERATE_MAX_REPAIRS=1
# Chatbot d'un cours (GET/POST /courses/{id}/chat) : quota par cours et par jour UTC,
# anti-rafale par IP, tours d'historique envoyes a Gemini, taille max du cours en contexte
CHAT_MESSAGE_MAX_LENGTH=1000
CHAT_DAILY_LIMIT=15
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_HISTORY_TURNS=4
CHAT_CONTEXT_MAX_CHARS=8000
CHAT_CONTEXT_TOP_SECTIONS=2
# Tentatives de quiz notees (POST /courses/{id}/quiz/attempts et .../submit) : limites par IP,
# taille max du cours envoye a Gemini pour recharger la banque de questions
QUIZ_ATTEMPT_RATE_LIMIT_PER_MINUTE=10
QUIZ_SUBMIT_RATE_LIMIT_PER_MINUTE=20
QUIZ_BANK_CONTEXT_MAX_CHARS=12000

# PostgreSQL configuration
# Docker Compose construit DATABASE_URL à partir de ces trois variables (api et worker) :
# mot de passe fort et sans caractère réservé d'URL (@ : / ? #), la valeur par défaut
# `synthoria` n'est acceptable qu'en développement local.
POSTGRES_USER=synthoria
POSTGRES_PASSWORD=synthoria
POSTGRES_DB=synthoria
# Ignoré par docker-compose.yml (reconstruit depuis POSTGRES_*) : à ajuster pour un dev hors Docker.
DATABASE_URL=postgresql+asyncpg://synthoria:synthoria@postgres:5432/synthoria

# Podcast (génération audio à partir d'un cours)
PODCAST_ENABLED=true
PODCAST_AUTO_GENERATE=false
PODCAST_STORAGE_DIR=/data/podcasts
PODCAST_TTS_BASE_URL=http://piper:5000
PODCAST_TTS_MODEL=fr_FR-upmc-medium
PODCAST_VOICE_HOST=fr_FR-upmc-medium:0
PODCAST_VOICE_EXPERT=fr_FR-upmc-medium:1
PODCAST_DEFAULT_TARGET_MINUTES=10
PODCAST_MAX_MINUTES=60
PODCAST_MAX_SEGMENTS=40
PODCAST_SCRIPT_BATCH_SIZE=4
PODCAST_TTS_CONCURRENCY=2
PODCAST_TTS_MAX_CHARS=400
PODCAST_WORKER_POLL_SECONDS=5
PODCAST_JOB_STALE_MINUTES=20
PODCAST_MAX_ATTEMPTS=3
PODCAST_AUDIO_BITRATE=96k
PODCAST_RETENTION_DAYS=30
PODCAST_GENERATE_RATE_LIMIT_PER_MINUTE=5

# Supports visuels (images ré-hébergées, jamais de hotlink, servies par GET /media/{id})
MEDIA_STORAGE_DIR=/data/media
MEDIA_MAX_BYTES=5242880
MEDIA_RESOLVE_CONCURRENCY=4
MEDIA_RESOLVE_TIMEOUT_SECONDS=20

# Lot 3 : résolveur d'images web (Wikimedia Commons -> Openverse)
MEDIA_WEB_ENABLED=true
# Obligatoire (nom de l'app, URL du repo, contact) : exigé par la politique Wikimedia, résolveur
# désactivé si vide. Exemple : "Synthoria LLM/1.0 (https://github.com/<org>/<repo>; contact@example.com)"
MEDIA_WEB_USER_AGENT=
MEDIA_WEB_PROVIDERS=["wikimedia","openverse"]
MEDIA_WEB_MAX_CANDIDATES=5
MEDIA_WEB_MIN_WIDTH=400
MEDIA_WEB_ALLOWED_LICENSES=["cc0","pdm","by","by-sa"]
MEDIA_WEB_VERIFY_ENABLED=true
MEDIA_WEB_VERIFY_MIN_SCORE=40
MEDIA_WEB_CACHE_TTL_HOURS=168
MEDIA_WEB_TIMEOUT_SECONDS=8
# Optionnels (quota anonyme Openverse sinon)
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# DNS des conteneurs api et worker (appels sortants Gemini, YouTube, Wikimedia...)
DNS_PRIMARY=8.8.8.8
DNS_SECONDARY=1.1.1.1