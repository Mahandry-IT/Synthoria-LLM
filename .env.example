[TEMPLATE]
# Ollama configuration
OLLAMA_BASE_URL=http://ollama:11435
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=3

# FastAPI configuration
REQUEST_MAX_PROMPT_LENGTH=8000
CORS_ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=30

# Chroma configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=synthoria_documents

# PDF processing configuration
PDF_CHUNK_TARGET_TOKENS=400
PDF_CHUNK_OVERLAP_TOKENS=50

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=300
GEMINI_USE_SEARCH_GROUNDING=false
# Marge sous la limite Google (ex. 15 RPM sur gemini-*-flash-lite au palier gratuit) : baisser si
# les conteneurs api ET worker sont utilisés de façon intensive en même temps (voir README).
GEMINI_RPM_LIMIT=14

# YouTube Data API v3 : recherche réelle de vidéos (remplace les IDs inventés par Gemini).
# Sans clé, repli automatique sur la recherche groundée Gemini + vérification oEmbed (voir README).
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=5.0
YOUTUBE_SEARCH_MAX_RESULTS=10
YOUTUBE_RELEVANCE_LANGUAGE=fr
YOUTUBE_REGION_CODE=FR
YOUTUBE_MIN_DURATION_SECONDS=240
YOUTUBE_MAX_DURATION_SECONDS=2400
YOUTUBE_MAX_QUERIES=2
YOUTUBE_CACHE_TTL_HOURS=72
# Cible 5 à 10 vidéos par cours (jamais garanti : dépend de ce que YouTube renvoie réellement).
COURSE_VIDEOS_MIN=5
COURSE_VIDEOS_MAX=10
# V2 (optionnel) : classement / catégorisation pédagogique des candidats par Flash-Lite.
COURSE_VIDEOS_RANKING_ENABLED=true
YOUTUBE_RANKING_MIN_SCORE=40

# Course generation (Mode 2) configuration
COURSE_TOP_K_DEFAULT=6
COURSE_QUESTION_MAX_LENGTH=2000
COURSE_PLAN_BATCH_SIZE=4
COURSE_PLAN_TTL_MINUTES=120

# PostgreSQL configuration
DATABASE_URL=postgresql+asyncpg://synthoria:synthoria@postgres:5432/synthoria

# Podcast (génération audio à partir d'un cours)
PODCAST_ENABLED=true
PODCAST_AUTO_GENERATE=false
PODCAST_STORAGE_DIR=/data/podcasts
PODCAST_TTS_BASE_URL=http://piper:5000
PODCAST_TTS_MODEL=fr_FR-upmc-medium
PODCAST_VOICE_HOST=fr_FR-upmc-medium:0
PODCAST_VOICE_EXPERT=fr_FR-upmc-medium:1
PODCAST_DEFAULT_TARGET_MINUTES=10
PODCAST_MAX_MINUTES=60
PODCAST_MAX_SEGMENTS=40
PODCAST_SCRIPT_BATCH_SIZE=4
PODCAST_TTS_CONCURRENCY=2
PODCAST_TTS_MAX_CHARS=400
PODCAST_WORKER_POLL_SECONDS=5
PODCAST_JOB_STALE_MINUTES=20
PODCAST_MAX_ATTEMPTS=3
PODCAST_AUDIO_BITRATE=96k
PODCAST_RETENTION_DAYS=30
PODCAST_GENERATE_RATE_LIMIT_PER_MINUTE=5

# Supports visuels (images ré-hébergées, jamais de hotlink, servies par GET /media/{id})
MEDIA_STORAGE_DIR=/data/media
MEDIA_MAX_BYTES=5242880
MEDIA_RESOLVE_CONCURRENCY=4
MEDIA_RESOLVE_TIMEOUT_SECONDS=20

# DNS configuration
DNS_PRIMARY=8.8.8.8
DNS_SECONDARY=1.1.1.1