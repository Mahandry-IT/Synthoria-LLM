                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Éléments par page (défaut: 20, max: 100)"
                }
              ]
            },
            "description": "Historique paginé des sessions de cours. Codes: 200, 400."
          },
          "response": []
        },
        {
          "name": "GET /courses/history/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/courses/history/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "history",
                "{{sessionId}}"
              ]
            },
            "description": "Détail d'une session avec la réponse Gemini complète. Codes: 200, 404, 422."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Video",
      "item": [
        {
          "name": "POST /video/generate/{session_id}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/video/generate/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "video",
                "generate",
                "{{sessionId}}"
              ]
            },
            "description": "Lance la génération vidéo pédagogique d'un cours existant (asynchrone via BackgroundTasks).\n\nWorkflow :\n1. POST → 202 Accepted { job_id, status: \"pending\", course_session_id }\n2. Poller GET /video/generate/{job_id}/status\n3. Quand status = \"succeeded\", télécharger via GET /video/{job_id}/download\n\nStoryboard extrait déterministement du gemini_response, envoyé à LTX-Video via HF Inference API.\n\nCodes: 202 job créé, 404 session introuvable, 409 job déjà en cours, 422 UUID malformé."
          },
          "response": []
        },
        {
          "name": "GET /video/generate/{job_id}/status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/video/generate/{{jobId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "video",
                "generate",
                "{{jobId}}",
                "status"
              ]
            },
            "description": "Polling du statut d'un job de génération vidéo.\n\nRéponse : { job_id, status (pending|running|succeeded|failed), model_used, fallback_used, video_url, error, created_at, updated_at }\n\nvideo_url n'est renseigné que quand status = \"succeeded\".\n\nCodes: 200, 404 job introuvable."
          },
          "response": []
        },
        {
          "name": "GET /video/{job_id}/download",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/video/{{jobId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "video",
                "{{jobId}}",
                "download"
              ]
            },
            "description": "Télécharge le fichier vidéo généré (MP4). Protégé contre path traversal.\n\nPrérequis : status = \"succeeded\" (video_url disponible via polling).\n\nCodes: 200 fichier MP4, 404 job introuvable ou vidéo non disponible."
          },
          "response": []
        }
      ]
    },
